  <circle cx="73" cy="66" r="13" fill="#0B8076" stroke="none"/>
  <polyline points="66,66 71,72 81,60" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Card title -->
  <text x="73" y="95" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">robots.txt</text>
  <!-- Description line 1 -->
  <text x="73" y="113" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">AI crawlers</text>
  <!-- Description line 2 -->
  <text x="73" y="128" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">allowed</text>

