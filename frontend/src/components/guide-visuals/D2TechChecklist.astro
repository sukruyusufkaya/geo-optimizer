<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 180" width="100%" height="auto" role="img" aria-labelledby="d2-tech-title">
  <title id="d2-tech-title">Technical layer — five checks</title>

  <!-- Background -->
  <rect width="680" height="180" fill="#F4F5F2"/>

  <!-- Section title -->
  <text x="340" y="22" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="600" fill="#0D110E">Technical layer — five checks</text>

  <!-- Card 1: robots.txt -->
  <rect x="12" y="36" width="122" height="132" rx="3" fill="#FFFFFF" stroke="#D9DED6" stroke-width="1.5"/>
