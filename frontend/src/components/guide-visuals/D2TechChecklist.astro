  <text x="205" y="113" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">Self-referencing</text>
  <text x="205" y="128" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">tag present</text>

  <!-- Card 3: Sitemap -->
  <rect x="276" y="36" width="122" height="132" rx="3" fill="#FFFFFF" stroke="#D9DED6" stroke-width="1.5"/>
