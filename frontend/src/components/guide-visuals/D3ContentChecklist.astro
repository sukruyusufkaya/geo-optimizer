<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 180" width="100%" height="auto" role="img" aria-labelledby="d3-content-title">
  <title id="d3-content-title">Content layer — five checks: Direct Answer, Clear Headings, Specific Facts, Numbered Steps, One Idea per Paragraph</title>

  <!-- Background -->
  <rect width="680" height="180" fill="#F4F5F2"/>

  <!-- Section header -->
  <text x="340" y="22" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="600" fill="#0D110E">Content layer — five checks</text>

  <!-- Divider below header -->
  <line x1="24" y1="32" x2="656" y2="32" stroke="#D9DED6" stroke-width="1"/>

  <!-- ── CARD 1: Direct Answer ── -->
  <rect x="24" y="44" width="120" height="122" rx="3" fill="#FFFFFF" stroke="#D9DED6" stroke-width="1"/>
  <!-- Checkmark circle -->
  <circle cx="84" cy="72" r="14" fill="#E4F3F0"/>
  <polyline points="76,72 81,78 93,65" fill="none" stroke="#0B8076" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Title -->
  <text x="84" y="98" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">Direct</text>
  <text x="84" y="113" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">Answer</text>
  <!-- Description -->
  <text x="84" y="132" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">Lead with the</text>
  <text x="84" y="146" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">answer, not</text>
  <text x="84" y="160" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">context first</text>

  <!-- ── CARD 2: Clear Headings ── -->
  <rect x="156" y="44" width="120" height="122" rx="3" fill="#FFFFFF" stroke="#D9DED6" stroke-width="1"/>
  <!-- Checkmark circle -->
  <circle cx="216" cy="72" r="14" fill="#E4F3F0"/>
  <polyline points="208,72 213,78 225,65" fill="none" stroke="#0B8076" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Title -->
  <text x="216" y="98" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">Clear</text>
  <text x="216" y="113" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">Headings</text>
  <!-- Description -->
  <text x="216" y="132" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">H2/H3 match</text>
  <text x="216" y="146" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">real questions</text>
  <text x="216" y="160" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">people ask</text>

  <!-- ── CARD 3: Specific Facts ── -->
  <rect x="288" y="44" width="120" height="122" rx="3" fill="#FFFFFF" stroke="#D9DED6" stroke-width="1"/>
  <!-- Checkmark circle -->
  <circle cx="348" cy="72" r="14" fill="#E4F3F0"/>
  <polyline points="340,72 345,78 357,65" fill="none" stroke="#0B8076" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Title -->
  <text x="348" y="98" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">Specific</text>
  <text x="348" y="113" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">Facts</text>
  <!-- Description -->
  <text x="348" y="132" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">Numbers, dates,</text>
  <text x="348" y="146" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">names the AI</text>
  <text x="348" y="160" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">can cite</text>

  <!-- ── CARD 4: Numbered Steps ── -->
  <rect x="420" y="44" width="120" height="122" rx="3" fill="#FFFFFF" stroke="#D9DED6" stroke-width="1"/>
  <!-- Checkmark circle -->
  <circle cx="480" cy="72" r="14" fill="#E4F3F0"/>
  <polyline points="472,72 477,78 489,65" fill="none" stroke="#0B8076" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Title -->
  <text x="480" y="98" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">Numbered</text>
  <text x="480" y="113" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">Steps</text>
  <!-- Description -->
  <text x="480" y="132" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">Ordered lists</text>
  <text x="480" y="146" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">signal clear</text>
  <text x="480" y="160" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">procedure</text>

  <!-- ── CARD 5: One Idea / Para ── -->
  <rect x="552" y="44" width="104" height="122" rx="3" fill="#FFFFFF" stroke="#D9DED6" stroke-width="1"/>
  <!-- Checkmark circle -->
  <circle cx="604" cy="72" r="14" fill="#E4F3F0"/>
  <polyline points="596,72 601,78 613,65" fill="none" stroke="#0B8076" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  <!-- Title -->
  <text x="604" y="98" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">One Idea</text>
  <text x="604" y="113" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="700" fill="#0D110E">/ Para</text>
  <!-- Description -->
  <text x="604" y="132" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">Short, dense</text>
  <text x="604" y="146" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">paragraphs</text>
  <text x="604" y="160" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="11" fill="#3D453F">easy to extract</text>
</svg>
