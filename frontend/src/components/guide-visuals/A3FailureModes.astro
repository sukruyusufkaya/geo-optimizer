<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 180" width="100%" height="auto" role="img" aria-labelledby="a3-fail-title">
  <title id="a3-fail-title">Common reasons a website fails to get cited by AI engines</title>

  <!-- Background -->
  <rect width="680" height="180" fill="#F4F5F2"/>

  <!-- Section title -->
  <text x="340" y="24" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="13" font-weight="600" fill="#0D110E">Common reasons a website fails to get cited by AI engines</text>

  <!-- Card 1: Blocked Crawlers -->
  <rect x="16" y="40" width="120" height="124" rx="3" fill="#F7F0DF" stroke="#9C6A06" stroke-width="1.5"/>
  <!-- Warning icon -->
  <polygon points="76,58 68,72 84,72" fill="none" stroke="#9C6A06" stroke-width="1.5" stroke-linejoin="round"/>
  <line x1="76" y1="63" x2="76" y2="68" stroke="#9C6A06" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="76" cy="70.5" r="0.8" fill="#9C6A06"/>
  <!-- Label -->
  <text x="76" y="92" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">Blocked</text>
  <text x="76" y="107" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">Crawlers</text>
  <!-- Description -->
  <text x="76" y="126" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">robots.txt or</text>
  <text x="76" y="139" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">noindex tags</text>
  <text x="76" y="152" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">block AI bots</text>

  <!-- Card 2: JS-only Content -->
  <rect x="148" y="40" width="120" height="124" rx="3" fill="#F7F0DF" stroke="#9C6A06" stroke-width="1.5"/>
  <!-- Warning icon -->
  <polygon points="208,58 200,72 216,72" fill="none" stroke="#9C6A06" stroke-width="1.5" stroke-linejoin="round"/>
  <line x1="208" y1="63" x2="208" y2="68" stroke="#9C6A06" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="208" cy="70.5" r="0.8" fill="#9C6A06"/>
  <!-- Label -->
  <text x="208" y="92" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">JS-only</text>
  <text x="208" y="107" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">Content</text>
  <!-- Description -->
  <text x="208" y="126" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">Text rendered</text>
  <text x="208" y="139" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">only via JS is</text>
  <text x="208" y="152" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">invisible to AI</text>

  <!-- Card 3: Thin Copy -->
  <rect x="280" y="40" width="120" height="124" rx="3" fill="#F7F0DF" stroke="#9C6A06" stroke-width="1.5"/>
  <!-- Warning icon -->
  <polygon points="340,58 332,72 348,72" fill="none" stroke="#9C6A06" stroke-width="1.5" stroke-linejoin="round"/>
  <line x1="340" y1="63" x2="340" y2="68" stroke="#9C6A06" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="340" cy="70.5" r="0.8" fill="#9C6A06"/>
  <!-- Label -->
  <text x="340" y="92" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">Thin</text>
  <text x="340" y="107" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">Copy</text>
  <!-- Description -->
  <text x="340" y="126" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">Too little text</text>
  <text x="340" y="139" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">for AI to extract</text>
  <text x="340" y="152" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">a clear answer</text>

  <!-- Card 4: Vague Claims -->
  <rect x="412" y="40" width="120" height="124" rx="3" fill="#F7F0DF" stroke="#9C6A06" stroke-width="1.5"/>
  <!-- Warning icon -->
  <polygon points="472,58 464,72 480,72" fill="none" stroke="#9C6A06" stroke-width="1.5" stroke-linejoin="round"/>
  <line x1="472" y1="63" x2="472" y2="68" stroke="#9C6A06" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="472" cy="70.5" r="0.8" fill="#9C6A06"/>
  <!-- Label -->
  <text x="472" y="92" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">Vague</text>
  <text x="472" y="107" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">Claims</text>
  <!-- Description -->
  <text x="472" y="126" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">Generic phrases</text>
  <text x="472" y="139" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">lack the facts</text>
  <text x="472" y="152" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">AI wants to cite</text>

  <!-- Card 5: No Schema -->
  <rect x="544" y="40" width="120" height="124" rx="3" fill="#F7F0DF" stroke="#9C6A06" stroke-width="1.5"/>
  <!-- Warning icon -->
  <polygon points="604,58 596,72 612,72" fill="none" stroke="#9C6A06" stroke-width="1.5" stroke-linejoin="round"/>
  <line x1="604" y1="63" x2="604" y2="68" stroke="#9C6A06" stroke-width="1.5" stroke-linecap="round"/>
  <circle cx="604" cy="70.5" r="0.8" fill="#9C6A06"/>
  <!-- Label -->
  <text x="604" y="92" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">No</text>
  <text x="604" y="107" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="12" font-weight="700" fill="#0D110E">Schema</text>
  <!-- Description -->
  <text x="604" y="126" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">Missing structured</text>
  <text x="604" y="139" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">data reduces AI</text>
  <text x="604" y="152" text-anchor="middle" font-family="Public Sans, system-ui, sans-serif" font-size="10" fill="#3D453F">confidence</text>
</svg>
