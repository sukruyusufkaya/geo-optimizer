# Copy to deploy/.env on the server and fill in. deploy/.env is gitignored.
# Every value here is optional — the app boots without any of them — but the
# first two should be set on a real deployment.

# CORS. Defaults to "*" (public demo). Restrict it to your own origin in
# production; a comma-separated list is accepted.
ALLOWED_ORIGINS=https://example.com

# nginx sits in front, so X-Forwarded-For is only trusted from it. Without this
# the app falls back to the socket peer, which would be the proxy itself and
# would make per-IP rate limiting collapse onto a single bucket.
TRUSTED_PROXIES=127.0.0.1

# Optional: when set, POST /api/audit requires "Authorization: Bearer <token>".
# Leave empty for a public demo surface.
GEO_API_TOKEN=

# Optional: external audit counter. Upstream points this at their own
# AgencyPilot instance by default; with no key set no request is ever made, so
# leave both empty unless you run your own stats endpoint.
GEO_STATS_API_URL=
GEO_STATS_API_KEY=

# Optional: enables POST /api/citations (Perplexity Sonar). Without it that one
# endpoint returns 503 and everything else works normally.
PERPLEXITY_API_KEY=
GEO_CITATIONS_DAILY_CAP=50
